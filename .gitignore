node_modules
.turbo
dist
bin
*.tsbuildinfo

# Generated from the client build: the filenames carry content hashes, so this
# changes on every build and belongs to the build, not to the repo. tsc reads
# `assets.generated.d.ts` instead, which is committed.
apps/host/src/assets.generated.js

# espeak-ng's Emscripten glue, copied out of the `text2wav` package with its
# filesystem mount patched out. It belongs to the installed dependency rather
# than to the repo, and `espeak.generated.d.ts` is what tsc reads.
apps/host/src/espeak.generated.js

# Piper clips packed for embedding (scripts/pack-narration.ts). CI makes these
# for release builds; `narration.generated.d.ts` is what tsc reads.
apps/host/narration
apps/host/src/narration.generated.js

# The show itself.
*.db
*.db-wal
*.db-shm

# A snapshot of the show, without the narration cache: `bun run db:snapshot`.
!data/gameshows.db

# Playwright MCP session logs.
.playwright-mcp
