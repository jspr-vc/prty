# --- packages/db ---
# Postgres is the one inside the Supabase CLI stack (`bunx supabase start`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
UPSTASH_REDIS_REST_URL=http://localhost:8089
UPSTASH_REDIS_REST_TOKEN=local_token

# --- packages/auth ---
BETTER_AUTH_SECRET=change-me-min-32-chars-long-secret-value
BETTER_AUTH_URL=http://localhost:3000

# --- packages/realtime ---
# These are the Supabase CLI's standard local keys, identical on every machine.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- apps ---
# Optional. Unset, everything is served from one origin (local development).
# Set in production to split the TV from the host console across two hosts;
# the join page and its QR code always live on the TV host.
NEXT_PUBLIC_TV_URL=http://localhost:3000
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3000
