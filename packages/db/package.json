{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./migrate": "./src/migrate.ts",
    "./env": "./src/env-db.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate && bun run db:bundle",
    "db:bundle": "bun run scripts/bundle-migrations.ts",
    "db:migrate": "bun run scripts/cli.ts migrate",
    "db:seed": "bun run scripts/cli.ts seed",
    "db:status": "bun run scripts/cli.ts status",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/common": "workspace:*",
    "@workspace/games": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/game-family-feud": "workspace:*",
    "@workspace/game-jeopardy": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
