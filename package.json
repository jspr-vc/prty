{
  "name": "gameshows",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "db:studio": "turbo run db:studio",
    "infra:up": "bunx supabase start && docker compose up -d",
    "infra:down": "docker compose down && bunx supabase stop",
    "infra:status": "bunx supabase status",
    "env:link": "test -f .env && ln -sfn ../../.env apps/gamemaster/.env && ln -sfn ../../.env apps/gameclient/.env || true",
    "prepare": "lefthook install || true; bun run env:link || true"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "lefthook": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/games/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.11",
      "@radix-ui/react-slot": "1.3.3",
      "@supabase/supabase-js": "2.112.4",
      "@t3-oss/env-nextjs": "0.13.11",
      "@tailwindcss/postcss": "4.3.3",
      "@tanstack/react-form": "1.33.5",
      "@tanstack/react-query": "5.102.8",
      "@tanstack/react-query-devtools": "5.102.8",
      "@tanstack/react-table": "9.2.4",
      "@trpc/client": "11.18.0",
      "@trpc/server": "11.18.0",
      "@trpc/tanstack-react-query": "11.18.0",
      "@types/node": "26.4.0",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.5",
      "@upstash/redis": "1.38.3",
      "better-auth": "1.7.2",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "dotenv": "17.4.2",
      "drizzle-kit": "0.31.10",
      "drizzle-orm": "0.45.2",
      "lefthook": "2.1.12",
      "lucide-react": "1.37.0",
      "next": "16.3.3",
      "postgres": "3.4.9",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "react-qr-code": "2.2.0",
      "server-only": "0.0.1",
      "supabase": "2.116.0",
      "superjson": "2.2.6",
      "tailwind-merge": "3.4.1",
      "tailwindcss": "4.3.3",
      "turbo": "2.10.12",
      "tw-animate-css": "1.4.0",
      "typescript": "7.0.2",
      "zod": "4.5.4"
    }
  }
}
